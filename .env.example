# Cloudflare R2 (S3-compatible). Leave unset to use the local sample corpus.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional key prefix. Empty = list every .eml in the bucket.
R2_PREFIX=
# When R2 is configured, also include data/emails/ (default is R2 only).
R2_INCLUDE_LOCAL=false
